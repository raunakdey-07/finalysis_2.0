# Copy to .env.local and fill in what you need. Nothing here is a placeholder secret.

# Canonical URL used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://finalysis.vercel.app

# Bearer token required by GET /api/cron/update-prices.
# If this is unset the job returns 503 and does not run. It is never optional.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Redis connection string for the end-of-day close snapshot.
# The job returns 503 without it, and prices then fall back to cache-only.
# REDIS_URL is accepted as an alias, for platforms that set that name.
KV_REDIS_URL=
