{
  "uid": "finalysis-reliability",
  "title": "Finalysis reliability",
  "description": "What the resilience layer is actually doing: which upstreams are answering, how often a reader was served a cached or stale value, and whether the circuit breaker is open.",
  "tags": ["finalysis", "reliability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "15s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(finalysis_upstream_requests_total, instance)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Upstream request outcome rate",
      "description": "Success against failure, per provider. A flat success line with no failures is the healthy state.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, result) (rate(finalysis_upstream_requests_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{provider}} {{result}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "How each price was obtained",
      "description": "live and cached are normal. daily_close and stale_cache mean a reader was served an old price because an upstream was unreachable, and the page said so.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(finalysis_price_freshness_total{instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Circuit breaker (price provider)",
      "description": "1 means outbound calls are being refused without attempting them, after repeated failures. 0 is closed.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "max(finalysis_circuit_breaker_open)",
          "legendFormat": "open"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Closed", "color": "green" }, "1": { "text": "Open", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cache hit rate",
      "description": "Across all three caches. A fall here means more requests are going upstream than before.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(finalysis_cache_events_total{cache=~\".*\",event=\"hit\"}[5m])) / clamp_min(sum(rate(finalysis_cache_events_total{cache=~\".*\",event=~\"hit|miss\"}[5m])), 0.000001)",
          "legendFormat": "hit rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.7 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Degraded responses",
      "description": "Requests that succeeded but with reduced data. Non-zero is the fallback layer doing its job.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(finalysis_degraded_responses_total{instance=~\"$instance\"})",
          "legendFormat": "degraded"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Rate-limited requests",
      "description": "Requests refused by the per-client limiter before any upstream work happened.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(finalysis_rate_limited_total{instance=~\"$instance\"})",
          "legendFormat": "limited"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Time spent waiting on providers",
      "description": "Average seconds per upstream request. A rise here is the provider slowing down before it starts failing.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(finalysis_upstream_duration_seconds_sum{instance=~\"$instance\"}[5m])) / clamp_min(sum by (provider) (rate(finalysis_upstream_requests_total{instance=~\"$instance\"}[5m])), 0.000001)",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Scrape health",
      "description": "Whether Prometheus can see Finalysis at all. This is the panel to check first: every other panel is empty when this is zero.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"finalysis\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}